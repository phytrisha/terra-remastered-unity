# Copy to .env and adjust. Every tool in tools/ sources this through tools/env.sh.
# Paths may use $ROOT (the project root) and $HOME.

# Blender 5.x binary (headless runs)
BLENDER=/Applications/Blender.app/Contents/MacOS/Blender

# Python of the Blender MCP install (live runs talk to the open Blender through its socket client)
BLENDER_MCP_PYTHON=$HOME/.local/share/uv/tools/blender-mcp/bin/python
# BLENDER_MCP_HOST=localhost
# BLENDER_MCP_PORT=9876

# Unity CLI and the Unity project driven by unity/*.cs
UNITY_CLI=$HOME/.unity/bin/unity
UNITY_PROJECT=$ROOT/UnityProject
